+    protected void showPopup(final WebView parent, final WebView popup) {
+        android.webkit.WebSettings from = parent.getSettings();
+        android.webkit.WebSettings to = popup.getSettings();
+        to.setJavaScriptEnabled(true);
+        to.setDomStorageEnabled(true);
+        to.setUserAgentString(from.getUserAgentString());
+        to.setSupportMultipleWindows(false);
+        android.webkit.CookieManager.getInstance().setAcceptThirdPartyCookies(popup, true);
+        popup.setWebViewClient(new WebViewClient());
+        final android.app.Dialog dialog = new android.app.Dialog(parent.getContext(), android.R.style.Theme_DeviceDefault_Light_NoActionBar);
+        dialog.setContentView(popup, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        popup.setWebChromeClient(new WebChromeClient() {
+            @Override
+            public void onCloseWindow(WebView window) {
+                dialog.dismiss();
+            }
+        });
+        dialog.setOnKeyListener((d, keyCode, event) -> {
+            if (keyCode == android.view.KeyEvent.KEYCODE_BACK && event.getAction() == android.view.KeyEvent.ACTION_UP) {
+                if (popup.canGoBack()) popup.goBack();
+                else dialog.dismiss();
+                return true;
+            }
+            return false;
+        });
+        dialog.setOnDismissListener(d -> popup.destroy());
+        dialog.show();
+    }
